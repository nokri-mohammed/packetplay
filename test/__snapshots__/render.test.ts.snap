// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`webrtc example snapshot with fake icons 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1320 720" role="img" aria-label="How a WebRTC call connects">
<title>How a WebRTC call connects</title>
<defs><symbol id="icon-cloud" viewBox="0 0 10 10"><rect width="10" height="10"/></symbol><symbol id="icon-laptop" viewBox="0 0 10 10"><rect width="10" height="10"/></symbol><symbol id="icon-router" viewBox="0 0 10 10"><rect width="10" height="10"/></symbol><symbol id="icon-server" viewBox="0 0 10 10"><rect width="10" height="10"/></symbol></defs>
<g class="groups"><g data-group="sams-home"><rect x="816" y="52" width="408" height="192" rx="12" fill="currentColor" fill-opacity="0.06" stroke="currentColor" stroke-opacity="0.35" stroke-dasharray="6 4"/><text class="group-label" x="828" y="72" font-family="system-ui, sans-serif" font-size="14" fill="currentColor" fill-opacity="0.8">Sam&#39;s home</text></g></g>
<g class="links"><line data-link="client--r1" x1="180" y1="360" x2="420" y2="360" stroke="currentColor" stroke-opacity="0.5" stroke-width="2"/><line data-link="r1--net" x1="420" y1="360" x2="660" y2="360" stroke="currentColor" stroke-opacity="0.5" stroke-width="2"/><line data-link="net--stun" x1="660" y1="360" x2="900" y2="360" stroke="currentColor" stroke-opacity="0.5" stroke-width="2"/><line data-link="net--sig" x1="660" y1="360" x2="900" y2="560" stroke="currentColor" stroke-opacity="0.5" stroke-width="2"/><line data-link="net--r2" x1="660" y1="360" x2="900" y2="160" stroke="currentColor" stroke-opacity="0.5" stroke-width="2"/><line data-link="r2--sam" x1="900" y1="160" x2="1140" y2="160" stroke="currentColor" stroke-opacity="0.5" stroke-width="2"/></g>
<g class="nodes"><g data-node="client" transform="translate(180,360)"><use href="#icon-laptop" x="-48" y="-48" width="96" height="96"/><text class="label" y="68" text-anchor="middle" font-family="system-ui, sans-serif" font-size="15" fill="currentColor">Your laptop</text></g><g data-node="r1" transform="translate(420,360)"><use href="#icon-router" x="-48" y="-48" width="96" height="96"/><text class="label" y="68" text-anchor="middle" font-family="system-ui, sans-serif" font-size="15" fill="currentColor">Your router</text><text class="sub" y="86" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" fill="currentColor" fill-opacity="0.7">NAT</text></g><g data-node="net" transform="translate(660,360)"><use href="#icon-cloud" x="-48" y="-48" width="96" height="96"/><text class="label" y="68" text-anchor="middle" font-family="system-ui, sans-serif" font-size="15" fill="currentColor">Internet</text></g><g data-node="stun" transform="translate(900,360)"><use href="#icon-server" x="-48" y="-48" width="96" height="96"/><text class="label" y="68" text-anchor="middle" font-family="system-ui, sans-serif" font-size="15" fill="currentColor">STUN server</text></g><g data-node="sig" transform="translate(900,560)"><use href="#icon-server" x="-48" y="-48" width="96" height="96"/><text class="label" y="68" text-anchor="middle" font-family="system-ui, sans-serif" font-size="15" fill="currentColor">call.example.com</text><text class="sub" y="86" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" fill="currentColor" fill-opacity="0.7">signaling</text></g><g data-node="r2" transform="translate(900,160)"><use href="#icon-router" x="-48" y="-48" width="96" height="96"/><text class="label" y="68" text-anchor="middle" font-family="system-ui, sans-serif" font-size="15" fill="currentColor">Sam&#39;s router</text></g><g data-node="sam" transform="translate(1140,160)"><use href="#icon-laptop" x="-48" y="-48" width="96" height="96"/><text class="label" y="68" text-anchor="middle" font-family="system-ui, sans-serif" font-size="15" fill="currentColor">Sam&#39;s laptop</text></g></g>
</svg>
"
`;
